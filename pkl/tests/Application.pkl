amends "pkl:test"

import "../v1alpha1/Application.pkl" as app

local service = new app.Service {
  image = "example/web:1"
}

local deployment = new app.Deployment {}

local tcp = new app.Tcp {
  port = 9418
}

local http = new app.Http {
  port = 8080
}

local multiPort = (service) {
  http = new Listing {
    new app.Http { port = 9000; domains { "s3.example.com" }; healthPath = "/health" }
    new app.Http { port = 9001; domains { "console.example.com" } }
  }
}

local site = new app.Service {
  static = new app.Static { dir = "dist" }
  http { domains { "example.com" } }
}

local cronJob = new app.CronJob {
  image = "example/backup:1"
  schedule = "*/2 * * * *"
}

local slack = new app.Slack { url = "slack-webhook" }

local postgres = new app.Postgres {}

local redis = new app.Redis {
  backup = new app.DatabaseBackup { keep = 3 }
  resources { cpu = "1" }
}

facts {
  ["service defaults"] {
    service.replicas == 1
    service.restart == "always"
    service.resources.cpu == "100m"
    service.resources.memory == "128Mi"
    service.http == null
    service.tcp == null
    service.dependsOn.isEmpty
    service.connect.isEmpty
    service.env.isEmpty
  }
  ["TCP defaults"] {
    tcp.port == 9418
    tcp.publicPort == null
  }
  ["HTTP defaults"] {
    !http.public
    !http.nodeLocal
    http.domains.isEmpty
    http.https
  }
  ["HTTP listing"] {
    (multiPort.http as Listing<app.Http>).length == 2
    (multiPort.http as Listing<app.Http>)[1].https
  }
  ["static site defaults"] {
    site.image == null
    !site.static.spa
    (site.http as app.Http).port == 8080
    (site.http as app.Http).healthPath == "/.orch/health"
    (site.http as app.Http).domains.toList() == List("example.com")
  }
  ["cron defaults"] {
    cronJob.resources.cpu == "100m"
    cronJob.resources.memory == "128Mi"
    cronJob.startDeadline == "1m"
    cronJob.timeout == "15m"
    cronJob.dependsOn.isEmpty
    cronJob.secretEnv.isEmpty
    cronJob.secretFiles.isEmpty
    cronJob.constraints.isEmpty
    cronJob.mounts.isEmpty
  }
  ["deployment defaults"] {
    deployment.maxSurge == 1
    deployment.maxUnavailable == 0
    deployment.healthDeadline == "2m"
    deployment.autoRollback
    !deployment.autoUpdate
  }
  ["notification defaults"] {
    slack.kind == "slack"
    slack.on.isEmpty
  }
  ["database defaults"] {
    postgres.engine == "postgres"
    postgres.version == "17"
    postgres.image == null
    postgres.resources.memory == "256Mi"
    postgres.resources.cpu == "100m"
    postgres.backup == null
    redis.engine == "redis"
    redis.backup.schedule == "0 3 * * *"
    redis.backup.keep == 3
    redis.resources.cpu == "1"
    redis.resources.memory == "128Mi"
  }
}
