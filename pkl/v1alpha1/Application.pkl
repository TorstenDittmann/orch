module orch.Application

/// The resolved application contract produced by every orch configuration.
fixed schema: "v1alpha1" = "v1alpha1"

/// A DNS-label application name.
name: DnsLabel

/// Services keyed by their DNS-label name. An application needs at least one
/// service or database.
services: Mapping<DnsLabel, Service>(length <= 100) = new {}

/// Scheduled one-shot jobs keyed by their DNS-label name.
cronJobs: Mapping<DnsLabel, CronJob>(length <= 100) = new {}

/// Node-local volumes keyed by their DNS-label name.
volumes: Mapping<DnsLabel, Volume>(length <= 100) = new {}

/// Databases orch runs, keyed by name. Each one becomes a service of that name
/// with its own volume, a generated password, and a `NAME-url` secret holding
/// the connection URL.
databases: Mapping<DatabaseName, Database>(length <= 20) = new {}

/// Rolling deployment behavior.
deploy: Deployment = new {}

typealias RestartPolicy = "always" | "on-failure" | "never"

typealias DnsLabel = String(length <= 63, matches(Regex(#"^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"#)))

/// A DNS label short enough to name the database's volumes and secrets.
typealias DatabaseName = DnsLabel(length <= 54)

typealias EnvironmentName = String(matches(Regex(#"^[A-Za-z_][A-Za-z0-9_]*$"#)))

typealias ManifestString = String(length <= 4096)

typealias Port = Int(isBetween(1, 65535))

class Service {
  image: String(!isBlank, length <= 1024)

  command: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}

  args: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}

  replicas: Int(isBetween(1, 100)) = 1

  restart: RestartPolicy = "always"

  resources: Resources = new {}

  http: Http? = null

  tcp: Tcp? = null

  /// A UDP endpoint published on the node that runs each replica. It requires
  /// an `http` or `tcp` endpoint on the same service for readiness.
  udp: Udp? = null

  dependsOn: Listing<DnsLabel>(length <= 64, isDistinct) = new {}

  env: Mapping<EnvironmentName, ManifestString>(length <= 256) = new {}

  secretEnv: Mapping<EnvironmentName, DnsLabel>(length <= 256) = new {}

  secretFiles: Listing<SecretFile>(length <= 64) = new {}

  /// Exact node-label matches required by every replica.
  constraints: Mapping<String(!isBlank, length <= 256), ManifestString(!isBlank)>(length <= 64) = new {}

  mounts: Listing<Mount>(length <= 64) = new {}

  /// How long a replica may take to exit after SIGTERM before it is killed,
  /// from "1s" to "10m". Unset means 10 seconds.
  stopGracePeriod: String? = null

  /// Run replicas with every Linux capability and access to the node's
  /// devices, for workloads that start their own containers, such as a Docker
  /// daemon. A privileged replica can take over its node. Only administrator
  /// credentials may deploy an application that sets it.
  privileged: Boolean = false

  /// Adds and removes replicas to keep average CPU use near a target. Leave
  /// `replicas` unset when this is set; `min` is the starting count.
  autoscale: Autoscale? = null
}

class Autoscale {
  min: Int(isBetween(1, 100)) = 1

  max: Int(isBetween(min, 100))

  /// Target average CPU use of each replica, as a percent of `resources.cpu`.
  cpuPercent: Int(isBetween(10, 100)) = 70
}

class Resources {
  cpu: String(matches(Regex(#"^[1-9][0-9]*(?:m)?$"#))) = "100m"

  memory: String(matches(Regex(#"^[1-9][0-9]*(?:Ki|Mi|Gi|Ti)$"#))) = "128Mi"
}

class Http {
  port: Port

  /// Expose this service as the catch-all plaintext listener on ingress port 80.
  public: Boolean = false

  domains: Listing<String>(length <= 100, isDistinct) = new {}

  healthPath: String(length <= 2048) = ""

  https: Boolean = true

  /// Publish HTTP routes only on the ingress-enabled node running each replica.
  /// Use this when a hostname points at that node, rather than shared ingress.
  nodeLocal: Boolean = false
}

class Tcp {
  port: Port

  /// Opens this port on every ingress node and proxies connections to ready replicas.
  publicPort: Port? = null

  /// Publishes this port on the node that runs each replica, keeping client addresses.
  nodePort: Port? = null
}

class Udp {
  port: Port

  /// Publishes this port on the node that runs each replica, keeping client addresses.
  nodePort: Port
}

class CronJob {
  image: String(!isBlank, length <= 1024)

  schedule: String(!isBlank, length <= 256)

  command: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}

  args: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}

  resources: Resources = new {}

  env: Mapping<EnvironmentName, ManifestString>(length <= 256) = new {}

  secretEnv: Mapping<EnvironmentName, DnsLabel>(length <= 256) = new {}

  secretFiles: Listing<SecretFile>(length <= 64) = new {}

  dependsOn: Listing<DnsLabel>(length <= 64, isDistinct) = new {}

  /// Exact node-label matches required to own this cron schedule.
  constraints: Mapping<String(!isBlank, length <= 256), ManifestString(!isBlank)>(length <= 64) = new {}

  startDeadline: String = "1m"

  timeout: String = "15m"

  /// Read-only mounts of local volumes that a service in this application
  /// owns. Each run is placed on the node that holds those volumes.
  mounts: Listing<Mount(readOnly)>(length <= 64) = new {}
}

class SecretFile {
  source: DnsLabel

  target: ManifestString
}

class Mount {
  source: DnsLabel

  target: ManifestString

  readOnly: Boolean = false
}

class Volume {
  driver: "local" = "local"

  /// Archives this volume on its node on a schedule. The volume must be
  /// mounted by a service.
  backup: VolumeBackup? = null
}

class VolumeBackup {
  /// Five-field cron schedule in UTC.
  schedule: String(!isBlank, length <= 256) = "0 3 * * *"

  /// How many archives to keep on the node.
  keep: Int(isBetween(1, 365)) = 7

  /// Command run in the owning service's container before each archive, for
  /// example to flush or save state. A failing command skips that backup.
  before: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}
}

class PreDeployHook {
  service: DnsLabel
  command: Listing<ManifestString(!isEmpty)>(length.isBetween(1, 256))
  args: Listing<ManifestString(!isEmpty)>(length <= 256) = new {}
  timeout: String = "15m"
}

class Deployment {
  preDeploy: PreDeployHook? = null

  maxSurge: Int(isBetween(0, 100)) = 1

  maxUnavailable: Int(isBetween(0, 100)) = 0

  healthDeadline: String = "2m"

  autoRollback: Boolean = true

  /// Redeploy when an image tag points to a new digest. The controller checks
  /// the registry every few minutes.
  autoUpdate: Boolean = false
}

abstract class Database {
  /// The engine this database runs.
  fixed engine: String

  /// Image tag of the engine's official image.
  version: String(!isBlank, length <= 128)

  /// Full image reference instead of the official image, for a mirror or a
  /// compatible build. `version` is ignored when this is set.
  image: String(!isBlank, length <= 1024)? = null

  resources: Resources = new {}

  /// Exact node-label matches for the node that runs the database and keeps
  /// its data.
  constraints: Mapping<String(!isBlank, length <= 256), ManifestString(!isBlank)>(length <= 64) = new {}

  /// Backs up the database on its node on a schedule. Off unless set, for
  /// example `backup = new DatabaseBackup {}` for nightly backups.
  backup: DatabaseBackup? = null
}

class DatabaseBackup {
  /// Five-field cron schedule in UTC.
  schedule: String(!isBlank, length <= 256) = "0 3 * * *"

  /// How many backups to keep on the node.
  keep: Int(isBetween(1, 365)) = 7
}

/// PostgreSQL, backed up with `pg_dump`.
class Postgres extends Database {
  fixed engine = "postgres"
  version = "17"
  resources { memory = "256Mi" }
}

/// MySQL, backed up with `mysqldump`.
class MySQL extends Database {
  fixed engine = "mysql"
  version = "8.4"
  resources { memory = "512Mi" }
}

/// MariaDB, backed up with `mariadb-dump`.
class MariaDB extends Database {
  fixed engine = "mariadb"
  version = "11.4"
  resources { memory = "256Mi" }
}

/// MongoDB, backed up with `mongodump`.
class MongoDB extends Database {
  fixed engine = "mongodb"
  version = "8.0"
  resources { memory = "512Mi" }
}

/// Redis with append-only persistence, backed up from a saved snapshot.
class Redis extends Database {
  fixed engine = "redis"
  version = "7.4"
}

/// libSQL server (sqld), backed up with SQLite's online backup. Clients
/// authenticate with the generated `NAME-token`.
class LibSQL extends Database {
  fixed engine = "libsql"
  version = "latest"
}
