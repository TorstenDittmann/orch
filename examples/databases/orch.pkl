amends "../../pkl/v1alpha1/Application.pkl"

name = "shop"

services {
  ["web"] {
    image = "ghcr.io/acme/shop:1.4.2"
    http = new Http {
      port = 8080
      healthPath = "/healthz"
    }
    dependsOn { "main"; "cache" }
    secretEnv {
      ["DATABASE_URL"] = "main-url"
      ["REDIS_URL"] = "cache-url"
    }
  }
}

databases {
  ["main"] = new Postgres {
    resources { memory = "1Gi" }
    backup = new DatabaseBackup {}
  }
  ["cache"] = new Redis {}
}
