amends "../../pkl/v1alpha1/Application.pkl"

name = "shop"

services {
  ["web"] {
    image = "ghcr.io/acme/shop:1.4.2"
    http = new Http {
      port = 8080
      healthPath = "/healthz"
    }
    connect {
      ["DATABASE_URL"] = "main"
      ["REDIS_URL"] = "cache"
    }
  }
}

databases {
  ["main"] = new Postgres {
    resources { memory = "1Gi" }
    backup = new DatabaseBackup {}
  }
  ["cache"] = new Redis { version = "7.4" }
}
