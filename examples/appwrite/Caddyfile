# Path routing that Traefik labels do in Appwrite's compose file. orch
# ingress terminates TLS in front of this, so Caddy listens on plain HTTP.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	handle /healthz {
		respond "ok"
	}
	handle /v1/realtime* {
		reverse_proxy appwrite-realtime:80
	}
	# The console answers on the Appwrite domain only. Other hostnames are
	# function and site domains, which the API serves.
	@console {
		host {$APPWRITE_DOMAIN}
		not path /v1/* /.well-known/*
	}
	handle @console {
		reverse_proxy appwrite-console:3000
	}
	handle {
		reverse_proxy appwrite:80
	}
}
