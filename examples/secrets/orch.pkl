amends "https://orch.torsten.work/pkl/v1alpha1/Application.pkl"

name = "secret-demo"

services {
  ["worker"] {
    image =
      "docker.io/library/busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0"
    command { "/bin/sh" }
    args { "-c"; "test -n \"$API_TOKEN\"; test -s /run/secrets/signing-key; exec sleep 3600" }
    secretEnv {
      ["API_TOKEN"] = "api-token"
    }
    secretFiles {
      new SecretFile {
        source = "signing-key"
        target = "/run/secrets/signing-key"
      }
    }
  }
}

cronJobs {
  ["credential-check"] {
    image =
      "docker.io/library/busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0"
    schedule = "0 * * * *"
    command { "/bin/sh" }
    args { "-c"; "test -n \"$API_TOKEN\"; test -s /run/secrets/signing-key" }
    secretEnv {
      ["API_TOKEN"] = "api-token"
    }
    secretFiles {
      new SecretFile {
        source = "signing-key"
        target = "/run/secrets/signing-key"
      }
    }
  }
}
