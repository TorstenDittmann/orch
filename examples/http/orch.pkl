amends "../../pkl/v1alpha1/Application.pkl"

name = "web-demo"

services {
  ["web"] {
    image =
      "docker.io/library/busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0"
    command {
      "/bin/sh"
    }
    args {
      "-c"
      "mkdir -p /www; printf 'ok\\n' >/www/healthz; printf 'hello from orch\\n' >/www/index.html; exec httpd -f -p 8080 -h /www"
    }
    replicas = 2
    resources {
      cpu = "100m"
      memory = "64Mi"
    }
    http = new Http {
      port = 8080
      healthPath = "/healthz"
    }
  }
}

deploy {
  maxSurge = 1
  maxUnavailable = 0
  healthDeadline = "30s"
  autoRollback = true
}
